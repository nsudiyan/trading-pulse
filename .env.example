# Шаблон переменных окружения для Trading Bot
# 1. Скопируй: cp .env.example .env
# 2. Заполни значениями ниже
# 3. НЕ КОММИТЬ .env в git — он уже в .gitignore
#
# Python-скрипты автоматически загружают .env при старте.
# Переменные окружения имеют приоритет над JSON-конфигами.

# ─── Telegram Bot ────────────────────────────────────────────
# Получи токен через @BotFather
TELEGRAM_BOT_TOKEN=ВАШ_BOT_TOKEN_ЗДЕСЬ

# Твой Telegram chat_id (узнать: @userinfobot)
TELEGRAM_CHAT_ID=ВАШ_CHAT_ID_ЗДЕСЬ

# ─── Telegram API (для channel_reader.py) ────────────────────
# Получи на my.telegram.org → API development tools
TELEGRAM_API_ID=ВАШ_API_ID
TELEGRAM_API_HASH=ВАШ_API_HASH
# Session string: получить командой: python3 channel_reader.py setup
TELEGRAM_SESSION_STRING=ВАШ_SESSION_STRING

# ─── Внешние источники данных (бесплатные, нужна регистрация) ───
# CryptoPanic — новости: cryptopanic.com → Account → Developer API
CRYPTOPANIC_API_KEY=

# SoSoValue — ETF потоки: sosovalue.com → Dashboard → API Keys
SOSOVALUE_API_KEY=

# LunarCrush — социальный сентимент: lunarcrush.com → Settings → API
LUNARCRUSH_API_KEY=

# ─── AI Chart Analysis (chart_analyzer.py) ───────────────────
# Получи на console.anthropic.com → API Keys
ANTHROPIC_API_KEY=ВАШ_ANTHROPIC_KEY_ЗДЕСЬ

# ─── Опционально ─────────────────────────────────────────────
# Путь к Obsidian vault (если используешь obsidian_bridge.py)
# OBSIDIAN_VAULT_PATH=/Users/username/Documents/Obsidian Vault
