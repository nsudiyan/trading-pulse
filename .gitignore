# ── Секреты — никогда не коммитить ──
telegram_config.json
obsidian_config.json
channels_config.json
.env
.env.*
!.env.example

# ── Кэш / системное ──
__pycache__/
*.pyc
.DS_Store

# ── Логи / локи / pid — все ──
*.log
*.lock
*.pid

# ── Бэкапы кода (физический архив — отдельным этапом) ──
*.backup_*
*.bak
*.bak_*
*.bak.*

